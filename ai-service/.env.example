# ============================================================================
# Requra.AI AI service environment template
# Copy this file to .env and replace only the values needed for your setup.
# Never commit .env, provider keys, service tokens, or other real secrets.
# ============================================================================

# -----------------------------------------------------------------------------
# Runtime and browser access
# -----------------------------------------------------------------------------
# development | production. Production validates required security/storage config.
ENV=development

# Comma-separated origins for the demo/browser endpoints.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# LLM reasoning provider
# -----------------------------------------------------------------------------
# Supported values: openrouter | openai | groq
LLM_PROVIDER=openrouter

# Optional JSON array of fallback providers/models. Example:
# LLM_FALLBACK_CHAIN=[{"provider":"groq","model":"llama-3.3-70b-versatile"}]
LLM_FALLBACK_CHAIN=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=Requra AI Pipeline

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional/legacy provider compatibility settings used by provider experiments.
GOOGLE_API_KEY=
GPT_OSS_API_KEY=
BASE_URL_KEY=

# ITI Bedrock Gateway (LLM_PROVIDER=iti, EMBEDDING_PROVIDER=iti)
# The ITI gateway credentials must come from ITI_API_KEY. Never commit the real key.
ITI_API_KEY=
ITI_BASE_URL=http://apiaccess.iti.net.eg/student
ITI_PRIMARY_MODEL=nvidia.nemotron-super-3-120b
ITI_FALLBACK_MODEL=openai.gpt-oss-120b-1:0
ITI_QUALITY_MODEL=mistral.mistral-large-3-675b-instruct
ITI_EMBEDDING_MODEL=amazon.titan-embed-text-v1


# -----------------------------------------------------------------------------
# Audio transcription
# -----------------------------------------------------------------------------
# Audio configuration is checked by /ready only when ENABLE_AUDIO=true.
ENABLE_AUDIO=false
# Supported values: groq | deepgram
TRANSCRIBE_PROVIDER=groq
GROQ_WHISPER_MODEL=whisper-large-v3
# Optional language hint, for example: en
GROQ_LANGUAGE=
DEEPGRAM_API_KEY=

# -----------------------------------------------------------------------------
# Service-to-service authentication
# -----------------------------------------------------------------------------
# Bearer token required by /internal/* in production and by protected local calls.
AI_INTERNAL_SERVICE_TOKEN=change-me-local-internal-token

# -----------------------------------------------------------------------------
# Durable storage and job dispatch
# -----------------------------------------------------------------------------
# Leave both empty for local in-memory storage and in-process job execution.
# Docker Compose overrides these with the postgres/redis service hostnames.
DATABASE_URL=
REDIS_URL=
QUEUE_NAME=ai_jobs

# -----------------------------------------------------------------------------
# Retention settings
# -----------------------------------------------------------------------------
JOB_RESULT_RETENTION_DAYS=30
CHUNK_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Embeddings and retrieval
# -----------------------------------------------------------------------------
# The default pipeline uses lexical BM25 retrieval. Embeddings/hybrid retrieval
# require a compatible provider key and database/vector support.
ENABLE_EMBEDDINGS=false
ENABLE_HYBRID_RETRIEVAL=false
# Supported values: openai | openrouter
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# Backend integration and source document downloads
# -----------------------------------------------------------------------------
# Used for backend content recovery and result callbacks. If BACKEND_BASE_URL
# is set, its origin is approved for authenticated backend requests.
BACKEND_BASE_URL=
BACKEND_SERVICE_TOKEN=

# Optional comma-separated public storage domains for file_url downloads.
# If empty, the code defaults to:
# s3.amazonaws.com,res.cloudinary.com,storage.googleapis.com,cloudfront.net
ALLOWED_DOWNLOAD_DOMAINS=
CALLBACK_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# Execution limits
# -----------------------------------------------------------------------------
MAX_JOB_RUNTIME_SECONDS=900
MAX_CONCURRENT_JOBS=4
PROVIDER_TIMEOUT_SECONDS=120
# Shared across all reasoning-model calls in one service process. Keep this at
# 1-2 for rate-limited/free models; increase only after provider load testing.
LLM_MAX_CONCURRENCY=2
# Retries after the initial request. Backoff is exponential with jitter and
# honours Retry-After up to LLM_RETRY_MAX_SECONDS.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=1.0
LLM_RETRY_MAX_SECONDS=30.0
# Skip a provider across subsequent node calls after confirmed credit/token
# exhaustion. Transient 429 rate limits continue to use normal retry backoff.
LLM_QUOTA_COOLDOWN_SECONDS=300

# -----------------------------------------------------------------------------
# Observability and privacy
# -----------------------------------------------------------------------------
# Keep DEBUG_LLM_IO=false in production; production hard-disables raw LLM I/O.
DEBUG_LLM_IO=false
ENABLE_PII_MASKING=true

# -----------------------------------------------------------------------------
# Conflict detection
# -----------------------------------------------------------------------------
# Enabled for the MVP. It calls the LLM only when deterministic candidate
# selection finds potentially related requirement pairs.
ENABLE_CONFLICT_DETECTION=true
CONFLICT_MIN_CONFIDENCE=0.80
CONFLICT_SIMILARITY_THRESHOLD=0.55
CONFLICT_TOP_K=5
CONFLICT_JACCARD_LOW=0.30
CONFLICT_JACCARD_HIGH=0.80

# -----------------------------------------------------------------------------
# Quality repair
# -----------------------------------------------------------------------------
# Enabled for the MVP. It runs only when the quality gate finds a repairable
# story defect and remains bounded by MAX_REPAIR_ATTEMPTS.
ENABLE_QUALITY_REPAIR=true
MAX_REPAIR_ATTEMPTS=1

# -----------------------------------------------------------------------------
# Mixed-source processing & operational limits
# -----------------------------------------------------------------------------
ENABLE_MIXED_SOURCE_JOBS=true
SOURCE_PROCESS_CONCURRENCY=3
STT_CONCURRENCY=2
MAX_AUDIO_SOURCES_PER_JOB=1
MAX_SOURCES_PER_JOB=10
MAX_DOCUMENT_BYTES=20971520
MAX_AUDIO_BYTES=52428800
MAX_TOTAL_UPLOAD_BYTES=104857600
MAX_AUDIO_DURATION_SECONDS=1800
INPUT_CACHE_TTL_SECONDS=86400
ALLOW_INPROCESS_QUEUE_IN_PRODUCTION=false

# -----------------------------------------------------------------------------
# Database connection pool (per process)
# -----------------------------------------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# -----------------------------------------------------------------------------
# Optional test/client helpers (not read by the API configuration)
# -----------------------------------------------------------------------------
# Used by the fixture upload runner and database integration test only.
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
TEST_DATABASE_URL=
