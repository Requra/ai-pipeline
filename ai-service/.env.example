# ============================================================================
# AI Pipeline — environment configuration
# Copy to .env and fill in. NEVER commit real secrets. /ready reports only
# booleans + provider names, never key material.
# ============================================================================

# development | production   (production fails fast on missing required config)
ENV=development

# Comma-separated browser origins for the demo CORS. REQUIRED in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- LLM reasoning provider: openrouter | openai | groq ---------------------
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=Requra AI Pipeline
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Audio transcription (only required when ENABLE_AUDIO=true) -------------
ENABLE_AUDIO=false
TRANSCRIBE_PROVIDER=groq
GROQ_WHISPER_MODEL=whisper-large-v3
DEEPGRAM_API_KEY=

# --- Service-to-service auth (REQUIRED in production for /internal/*) -------
AI_INTERNAL_SERVICE_TOKEN=

# --- Durable store (PostgreSQL + pgvector). Unset → in-memory (dev only) ----
DATABASE_URL=postgresql+asyncpg://ai:ai@localhost:5432/ai_pipeline

# --- Queue / dispatch cache (Redis). Unset → in-process runner (dev only) ---
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=ai_jobs

# --- Retention --------------------------------------------------------------
JOB_RESULT_RETENTION_DAYS=30
CHUNK_RETENTION_DAYS=30

# --- Embeddings / hybrid retrieval (opt-in; MVP is lexical BM25) ------------
ENABLE_EMBEDDINGS=false
ENABLE_HYBRID_RETRIEVAL=false
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Backend integration (callback + document fetch) ------------------------
BACKEND_BASE_URL=
BACKEND_SERVICE_TOKEN=
CALLBACK_TIMEOUT_SECONDS=15

# --- Execution limits -------------------------------------------------------
MAX_JOB_RUNTIME_SECONDS=900
MAX_CONCURRENT_JOBS=4
PROVIDER_TIMEOUT_SECONDS=120

# --- Observability (NEVER enable DEBUG_LLM_IO in production) -----------------
DEBUG_LLM_IO=false

# --- LangSmith tracing (optional) -------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=requra-ai-pipeline
