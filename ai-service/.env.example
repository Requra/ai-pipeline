# ============================================================
#  AI Pipeline — Environment Configuration
#  Copy this file to .env and fill in your keys.
#  NEVER commit .env to version control.
# ============================================================

# --- LLM Providers (MVP: OpenAI for all reasoning nodes) ---
# For the MVP all reasoning nodes use OpenAI. Audio transcription remains
# provider-based and separate (Groq/Deepgram).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Deprecated/ignored for MVP (kept only for backwards compatibility):
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=

# --- Transcription Providers ---
# Get your free Groq key at: https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Get your free Deepgram key at: https://deepgram.com (free $200 credit)
DEEPGRAM_API_KEY=your_deepgram_key_here

# Active transcription provider: "groq" or "deepgram"
# - groq     → Whisper large-v3 (best for Egyptian Arabic + English code-switching)
# - deepgram → Nova-2 (native speaker diarization, less dialect support)
# TRANSCRIBE_PROVIDER=deepgram

# --- App Configuration ---
LOG_LEVEL=DEBUG
