    "/internal/jobs/{job_id}/retry": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Retry Job",
        "description": "Retry a failed/cancelled job as a new attempt.\n\nOnly ``FAILED``/``CANCELLED`` jobs are retryable (matches the ``reprocess``\nflag rules on ``POST /internal/jobs``) — a running or already-terminal-\nsuccess job returns 409. The check-and-requeue is atomic (row-locked), so\ntwo concurrent ``/retry`` calls for the same job can never both dispatch.",
        "operationId": "retry_job_internal_jobs__job_id__retry_post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
