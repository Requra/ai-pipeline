# ============================================================================
# Requra.AI Production Environment Configuration (Northflank Deployment)
# ============================================================================

ENV=production
ALLOWED_ORIGINS=https://app.requra.ai,https://api.requra.ai

# Database (Neon PostgreSQL with pgvector)
# DSN format: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2

# Redis / Queue (Northflank Private Redis Addon)
REDIS_URL=redis://requra-ai-redis.requra-ai.svc.cluster.local:6379
QUEUE_NAME=ai_jobs

# Service-to-Service Security
AI_INTERNAL_SERVICE_TOKEN=generate-a-secure-random-64-char-hex-token

# Reasoning LLM Provider — verified ITI demo configuration.
# Set ITI_API_KEY as a Northflank secret; never commit a real value.
LLM_PROVIDER=iti
ITI_API_KEY=
ITI_BASE_URL=http://apiaccess.iti.net.eg/student
ITI_PRIMARY_MODEL=nvidia.nemotron-super-3-120b
ITI_FALLBACK_MODEL=openai.gpt-oss-120b-1:0
ITI_QUALITY_MODEL=mistral.mistral-large-3-675b-instruct
ITI_EMBEDDING_MODEL=amazon.titan-embed-text-v1
# ITI_FALLBACK_MODEL is used automatically when LLM_FALLBACK_CHAIN is unset.
LLM_FALLBACK_CHAIN=

# Audio Transcription Provider
ENABLE_AUDIO=true
TRANSCRIBE_PROVIDER=groq
# Required Northflank secret for WAV/MP3 transcription; verify it before demo day.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3

# Semantic Retrieval & Embeddings
ENABLE_EMBEDDINGS=false
ENABLE_HYBRID_RETRIEVAL=false

# Free-Tier Safe Concurrency
MAX_CONCURRENT_JOBS=1
LLM_MAX_CONCURRENCY=1
SOURCE_PROCESS_CONCURRENCY=2
STT_CONCURRENCY=1
LLM_MAX_RETRIES=2
DEBUG_LLM_IO=false
ENABLE_PII_MASKING=true

# Retention & Maintenance
JOB_RESULT_RETENTION_DAYS=30
CHUNK_RETENTION_DAYS=30
